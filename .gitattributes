# Normalize line endings across platforms
* text=auto

# Source files should use LF to avoid toolchain issues on non-Windows hosts
*.c     text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.hpp   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.cmake text eol=lf
*.md    text eol=lf

# Windows scripts keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary assets
*.bin binary
*.elf binary
*.map binary
*.jpg binary
*.png binary
